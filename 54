from pathlib import Path

src = Path("research/adreno-port/hakios-adreno-reference.c").read_text()
lines = src.splitlines()

terms = [
    "step 18",
    "step 19",
    "step 20",
    "step 21",
    "step_core",
    "step_zap",
    "step_sqe",
    "ring",
    "SQE",
    "CP_MEM",
    "CP_INIT",
    "RB_CNTL",
    "A6XX_RB",
]

hits = []
for i, line in enumerate(lines):
    if any(t.lower() in line.lower() for t in terms):
        hits.append(i)

ranges = []
for h in hits:
    a = max(0, h - 12)
    b = min(len(lines), h + 45)
    ranges.append((a, b))

ranges.sort()
merged = []
for a, b in ranges:
    if merged and a <= merged[-1][1]:
        merged[-1] = (merged[-1][0], max(merged[-1][1], b))
    else:
        merged.append((a, b))

out = []
for a, b in merged:
    out.append(f"\n/* linhas {a+1}-{b} */")
    for n in range(a, b):
        out.append(f"{n+1:5}: {lines[n]}")

Path("research/adreno-port/hakios-steps-18-21.txt").write_text(
    "\n".join(out) + "\n"
)
print("gerado: research/adreno-port/hakios-steps-18-21.txt")
print("linhas:", sum(b-a for a,b in merged))

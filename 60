{
    struct smc_result ret;

    stage = "PAS shutdown";
    step("PAS: testa SHUTDOWN somente");
    ret = smc_pas(SCM_PAS_SHUTDOWN, SCM_ONE_VALUE,
                  PAS_ID_GPU_ZAP, 0, 0, 0);

    showhex("PAS shutdown x0", ret.x0);
    showhex("PAS shutdown x1", ret.x1);
    showhex("PAS shutdown x2", ret.x2);
    showhex("PAS shutdown x3", ret.x3);

    if (ret.x0 != 0) {
        con_str("PAS", "SHUTDOWN retornou erro");
        return 0;
    }

    con_str("PAS", "SHUTDOWN respondeu OK");
    return 1;
}

'''

if anchor not in s:
    raise SystemExit("Ponto de inserção não encontrado.")

p.write_text(s.replace(anchor, fn + anchor, 1))
print("pas_shutdown_probe inserido")

from pathlib import Path

p = Path("shim/m11.c")
s = p.read_text()

if "pas_supported_probe" in s:
    raise SystemExit("O probe PAS_SUPPORTED já foi aplicado.")

anchor = "#define H2F_MSG_INIT"
pos = s.find(anchor)
if pos < 0:
    raise SystemExit("Constante H2F_MSG_INIT não encontrada.")

line_end = s.find("\n", pos)
if line_end < 0:
    raise SystemExit("Fim da linha H2F_MSG_INIT não encontrado.")

defs = """
#define SCM_SVC_PIL                 0x02u
#define SCM_PAS_IS_SUPPORTED_CMD    0x07u
#define SCM_PAS_IS_SUPPORTED        0x42000207u
#define PAS_ID_GPU_ZAP              13u
"""

s = s[:line_end + 1] + defs + s[line_end + 1:]

anchor2 = "static int pas_metadata_stage(void)"
pos2 = s.find(anchor2)
if pos2 < 0:
    raise SystemExit("pas_metadata_stage não encontrada.")

probe = """
static int pas_supported_probe(void)
{
    uint64_t ret;

    stage = "PAS supported";
    step("PAS: consulta IS_SUPPORTED");
    ret = smc(SCM_PAS_IS_SUPPORTED, PAS_ID_GPU_ZAP, 0, 0);
    showhex("PAS supported ret", ret);

    if (ret != 0) {
        con_str("PAS", "TrustZone nao confirmou PAS 13");
        return 0;
    }

    con_str("PAS", "TrustZone confirmou PAS 13");
    return 1;
}

"""

s = s[:pos2] + probe + s[pos2:]

old = """\tif (!pas_metadata_stage())
\t\treturn;"""

new = """\tif (!pas_supported_probe())
\t\treturn;

\tif (!pas_metadata_stage())
\t\treturn;"""

if old not in s:
    raise SystemExit("Chamada de pas_metadata_stage não encontrada.")

s = s.replace(old, new, 1)
p.write_text(s)
print("probe PAS_IS_SUPPORTED aplicado; nenhuma chamada de carregamento foi adicionada")

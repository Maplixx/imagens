python3 - <<'PY'
from pathlib import Path

p = Path("shim/plat.c")
s = p.read_text()

marker = """uint64_t smc(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
{"""

if marker not in s:
    raise SystemExit("Ponto de inserção smc() não encontrado.")

fn = r'''/*
 * Qualcomm SCM/PAS:
 *   x0 = função
 *   x1 = arginfo
 *   x2..x5 = argumentos
 *   x6 = sessão para chamadas interrompidas
 *   x7 = reservado
 *
 * A chamada é repetida quando TrustZone retorna SCM_INTERRUPTED (1).
 */
struct smc_result smc_pas(uint64_t fn, uint64_t arginfo,
                          uint64_t arg2, uint64_t arg3,
                          uint64_t arg4, uint64_t arg5)
{
    struct smc_result r;
    uint64_t session = 0;

    for (unsigned attempt = 0; attempt < 100; attempt++) {
        register uint64_t x0 __asm__("x0") =
            attempt == 0 ? fn : 1u;
        register uint64_t x1 __asm__("x1") = arginfo;
        register uint64_t x2 __asm__("x2") = arg2;
        register uint64_t x3 __asm__("x3") = arg3;
        register uint64_t x4 __asm__("x4") = arg4;
        register uint64_t x5 __asm__("x5") = arg5;
        register uint64_t x6 __asm__("x6") = session;
        register uint64_t x7 __asm__("x7") = 0;

        __asm__ volatile(
            "smc #0"
            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
              "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
            :
            : "x8", "x9", "x10", "x11", "x12", "x13",
              "x14", "x15", "x16", "x17", "memory");

        session = x6;

        if (x0 != 1u) {
            r.x0 = x0;
            r.x1 = x1;
            r.x2 = x2;
            r.x3 = x3;
            return r;
        }
    }

    r.x0 = 0xffffffffffffffffULL;
    r.x1 = r.x2 = r.x3 = 0;
    return r;
}

'''

p.write_text(s.replace(marker, fn + marker, 1))
print("smc_pas adicionada")
